[Unit]
Description=Paattu music engine (mpv + yt-dlp)
Documentation=file://%h/Work/paattu/README.md
After=pipewire.service pipewire-pulse.service

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %t/paattu
ExecStart=/usr/bin/mpv --config-dir=%h/.config/paattu/mpv --input-ipc-server=%t/paattu/mpv.sock
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
