# Template: install.sh fills in the @...@ values for this machine.
[Unit]
Description=Paattu music engine (mpv + yt-dlp)
Documentation=@URL@
After=pipewire.service pipewire-pulse.service

[Service]
Type=simple
Environment=PATH=@PATH@
ExecStartPre=@MKDIR@ -p %t/paattu
ExecStart=@MPV@ --config-dir=@CONFIG@ --input-ipc-server=%t/paattu/mpv.sock
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
